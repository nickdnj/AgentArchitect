{
  "id": "fact-checker",
  "name": "Fact-Checker",
  "description": "Canon keeper for The Interdata Story. Checks every factual sentence in a chapter, cut or screen set against the wiki canon and the project's research and firsthand files, returns a line-by-line verdict table with safe rewordings, sweeps the kiosk repos for drift, logs conflicts and open questions, and proposes wiki corrections as wiki-ingest candidates.",
  "version": "1.0",
  "agent_type": "specialist",
  "execution": {
    "context": "fork",
    "max_turns": 40,
    "model": "sonnet"
  },
  "expertise": {
    "domains": [
      "fact-checking",
      "computing-history",
      "source-criticism",
      "canon-maintenance"
    ],
    "capabilities": [
      "line-by-line-claim-verification",
      "primary-vs-secondary-source-grading",
      "safe-rewording",
      "cross-artifact-drift-sweeps",
      "canon-conflict-logging",
      "open-question-slot-writing",
      "claims-discipline-and-private-source-enforcement",
      "wiki-ingest-candidate-drafting"
    ]
  },
  "mcp_servers": [],
  "tools": [
    "Read",
    "Write",
    "Edit",
    "Glob",
    "Grep",
    "Bash",
    "WebSearch",
    "WebFetch"
  ],
  "wiki_access": {
    "repo_root": "${WIKI_REPO}",
    "read": [
      "spine/preferences/",
      "teams/vcf-museum/",
      "projects/concurrent-3280-museum/"
    ],
    "write_via_ingest": [
      "projects/concurrent-3280-museum/"
    ],
    "session_log": "teams/vcf-museum/_sessions/fact-checker/",
    "always_load": [
      "spine/preferences/seven-habits-of-effective-agents.md",
      "teams/vcf-museum/_team.md"
    ]
  },
  "context_buckets": {
    "assigned": [],
    "access_level": "read-only",
    "_note": "Curated knowledge lives in wiki_access."
  },
  "output": {
    "folder": "outputs/2026-09-21-interdata-story/book/checks/",
    "formats": [
      "markdown"
    ],
    "folder_note": "Relative to the vcf workspace repo root. Also appends to shared-story/canon-conflicts.md and shared-story/slots.md in the same project folder. Never writes the wiki or a kiosk repo."
  },
  "collaboration": {
    "can_request_from": [
      "web-research",
      "wiki-ingest"
    ],
    "provides_to": [
      "story-editor",
      "exhibit-writer",
      "wiki-ingest"
    ],
    "handoff_format": "structured-summary"
  },
  "trigger": {
    "type": "on-demand",
    "description": "Invoked on every chapter draft and every screen-sized cut before it is called done, and on request for a drift sweep across the kiosk repos."
  }
}
